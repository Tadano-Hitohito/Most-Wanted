<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.clean.css"><link rel="stylesheet" href="/stylesheets/listado.css"><link rel="stylesheet" href="/stylesheets/detalle.css"></head>
<body class="data-page"><header class="data-header"><a href="/" class="data-brand"><span class="brand-mark">SI</span><span><strong>Sistema institucional</strong><small>Detalle de expediente</small></span></a><a href="/expedientes" class="data-back">← Expedientes</a></header>
<main class="data-main"><section class="profile-header"><div class="profile-avatar"><%= oficial.nombres.charAt(0) %><%= oficial.apellidos.charAt(0) %></div><div><span class="status-pill"><%= oficial.estatus_actual || 'Activo' %></span><h1><%= oficial.nombres %> <%= oficial.apellidos %></h1><p><%= oficial.cedula %> · <%= oficial.rango || 'Rango sin asignar' %></p></div><a href="/administrar/<%= oficial.id %>" class="primary-action">Editar datos</a></section>
<section class="detail-grid"><article class="detail-card"><h2>Datos personales</h2><dl><div><dt>Cédula</dt><dd><%= oficial.cedula || '—' %></dd></div><div><dt>Sexo</dt><dd><%= oficial.sexo || '—' %></dd></div><div><dt>Edad</dt><dd><%= oficial.edad || '—' %></dd></div><div><dt>Fecha de nacimiento</dt><dd><%= oficial.fecha_nacimiento || '—' %></dd></div><div><dt>Dirección</dt><dd><%= oficial.direccion || '—' %></dd></div><div><dt>Correo</dt><dd><%= oficial.correo || '—' %></dd></div><div><dt>Teléfono móvil</dt><dd><%= oficial.telefono_movil || '—' %></dd></div></dl></article>
<article class="detail-card"><h2>Datos profesionales</h2><dl><div><dt>Rango</dt><dd><%= oficial.rango || '—' %></dd></div><div><dt>Estatus</dt><dd><%= oficial.estatus_actual || '—' %></dd></div><div><dt>Credencial única</dt><dd><%= oficial.credencial_unica || '—' %></dd></div><div><dt>Fecha de ingreso</dt><dd><%= oficial.fecha_ingreso || '—' %></dd></div><div><dt>Nivel académico</dt><dd><%= oficial.nivel_academico || '—' %></dd></div><div><dt>Especialidades</dt><dd><%= oficial.especialidades || '—' %></dd></div></dl></article></section></main></body></html>
