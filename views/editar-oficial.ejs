<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.clean.css"><link rel="stylesheet" href="/stylesheets/listado.css"><link rel="stylesheet" href="/stylesheets/detalle.css"><link rel="stylesheet" href="/stylesheets/register.css"></head>
<body class="data-page"><header class="data-header"><a href="/" class="data-brand"><span class="brand-mark">SI</span><span><strong>Sistema institucional</strong><small>Editar oficial</small></span></a><a href="/administrar" class="data-back">← Administración</a></header>
<main class="data-main"><section class="data-heading"><div><span>GESTIÓN DE DATOS</span><h1>Editar oficial</h1><p>Actualiza la información personal y profesional seleccionada.</p></div></section>
<% if (typeof saved !== 'undefined' && saved) { %><div class="save-message">Datos guardados correctamente.</div><% } %>
<form class="edit-form" method="post"><section><h2>Datos personales</h2><div class="form-grid"><label>Cédula<input name="cedula" value="<%= oficial.cedula || '' %>"></label><label>Apellidos<input name="apellidos" value="<%= oficial.apellidos || '' %>"></label><label>Nombres<input name="nombres" value="<%= oficial.nombres || '' %>"></label><label>Sexo<select name="sexo"><option <%= oficial.sexo === 'Masculino' ? 'selected' : '' %>>Masculino</option><option <%= oficial.sexo === 'Femenino' ? 'selected' : '' %>>Femenino</option></select></label><label>Edad<input name="edad" type="number" value="<%= oficial.edad || '' %>"></label><label>Fecha de nacimiento<input name="fecha_nacimiento" type="date" value="<%= oficial.fecha_nacimiento || '' %>"></label><label class="span-2">Dirección<input name="direccion" value="<%= oficial.direccion || '' %>"></label><label>Correo<input name="correo" type="email" value="<%= oficial.correo || '' %>"></label><label>Teléfono móvil<input name="telefono_movil" value="<%= oficial.telefono_movil || '' %>"></label></div></section><section><h2>Datos profesionales</h2><div class="form-grid"><label>Rango<input name="rango" value="<%= oficial.rango || '' %>"></label><label>Estatus actual<select name="estatus_actual"><option <%= oficial.estatus_actual === 'Activo' ? 'selected' : '' %>>Activo</option><option <%= oficial.estatus_actual === 'Licencia' ? 'selected' : '' %>>Licencia</option><option <%= oficial.estatus_actual === 'Comisión' ? 'selected' : '' %>>Comisión</option><option <%= oficial.estatus_actual === 'Baja administrativa' ? 'selected' : '' %>>Baja administrativa</option></select></label></div></section><div class="form-actions"><a class="button-cancel" href="/administrar">Cancelar</a><button class="button-save" type="submit">Guardar cambios</button></div></form></main></body></html>
