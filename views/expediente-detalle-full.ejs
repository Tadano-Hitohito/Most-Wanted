<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/stylesheets/style.clean.css"><link rel="stylesheet" href="/stylesheets/listado.css"><link rel="stylesheet" href="/stylesheets/detalle.css"></head>
<body class="data-page"><header class="data-header"><a href="/" class="data-brand"><span class="brand-mark">SI</span><span><strong>Sistema institucional</strong><small>Expediente completo</small></span></a><a href="/expedientes" class="data-back">← Expedientes</a></header>
<main class="data-main"><section class="profile-header"><div class="profile-avatar"><%= oficial.nombres.charAt(0) %><%= oficial.apellidos.charAt(0) %></div><div><span class="status-pill"><%= profesional.estatus_actual || 'Activo' %></span><h1><%= oficial.nombres %> <%= oficial.apellidos %></h1><p><%= oficial.cedula %> · <%= profesional.rango || 'Rango sin asignar' %></p></div><a href="/administrar/<%= oficial.id %>" class="primary-action">Editar datos</a></section>
<section class="detail-grid"><article class="detail-card"><h2>Datos personales</h2><dl><div><dt>Cédula</dt><dd><%= oficial.cedula || '—' %></dd></div><div><dt>Nombres y apellidos</dt><dd><%= oficial.nombres %> <%= oficial.apellidos %></dd></div><div><dt>Sexo</dt><dd><%= oficial.sexo || '—' %></dd></div><div><dt>Edad</dt><dd><%= oficial.edad || '—' %></dd></div><div><dt>Fecha de nacimiento</dt><dd><%= oficial.fecha_nacimiento || '—' %></dd></div><div><dt>Lugar de nacimiento</dt><dd><%= oficial.lugar_nacimiento || '—' %></dd></div><div><dt>Grupo sanguíneo</dt><dd><%= oficial.grupo_sanguineo || '—' %></dd></div><div><dt>Estado civil</dt><dd><%= oficial.estado_civil || '—' %></dd></div><div><dt>RIF</dt><dd><%= oficial.rif || '—' %></dd></div><div><dt>Carnet de la Patria</dt><dd><%= oficial.carnet_patria || '—' %></dd></div><div><dt>Dirección</dt><dd><%= oficial.direccion || '—' %></dd></div><div><dt>Correo</dt><dd><%= oficial.correo || '—' %></dd></div><div><dt>Teléfono móvil</dt><dd><%= oficial.telefono_movil || '—' %></dd></div><div><dt>Talla de gorra</dt><dd><%= oficial.talla_gorra || 'Talla Única' %></dd></div></dl></article>
<article class="detail-card"><h2>Datos profesionales</h2><dl><div><dt>Rango</dt><dd><%= profesional.rango || '—' %></dd></div><div><dt>Estatus</dt><dd><%= profesional.estatus_actual || '—' %></dd></div><div><dt>Credencial única</dt><dd><%= profesional.credencial_unica || '—' %></dd></div><div><dt>Fecha de ingreso</dt><dd><%= profesional.fecha_ingreso || '—' %></dd></div><div><dt>Curso de formación</dt><dd><%= profesional.curso_formacion || '—' %></dd></div><div><dt>Nivel académico</dt><dd><%= profesional.nivel_academico || '—' %></dd></div><div><dt>Especialidades</dt><dd><%= profesional.especialidades || '—' %></dd></div><div><dt>Institución</dt><dd><%= profesional.institucion || '—' %></dd></div></dl></article>
<article class="detail-card"><h2>Condición vulnerable</h2><dl><div><dt>Área</dt><dd><%= vulnerable.area || '—' %></dd></div><div><dt>Tipo de vivienda</dt><dd><%= vulnerable.tipo_vivienda || '—' %></dd></div><div><dt>Gravedad</dt><dd><%= vulnerable.gravedad_inmueble || '—' %></dd></div><div><dt>Personas en vivienda</dt><dd><%= vulnerable.cantidad_personas_vivienda || '—' %></dd></div><div><dt>Hijos</dt><dd><%= vulnerable.cantidad_hijos || '—' %></dd></div><div><dt>Mayor(es) a cargo</dt><dd><%= vulnerable.personas_tercera_edad || '—' %></dd></div></dl></article>
<article class="detail-card"><h2>Condición médica y emergencia</h2><dl><div><dt>Patología</dt><dd><%= medica.patologia_medica || '—' %></dd></div><div><dt>Alergias</dt><dd><%= medica.alergias || '—' %></dd></div><div><dt>Contacto</dt><dd><%= emergencia.nombres_apellidos_familiar || '—' %></dd></div><div><dt>Parentesco</dt><dd><%= emergencia.parentesco || '—' %></dd></div><div><dt>Teléfono</dt><dd><%= emergencia.telefono || '—' %></dd></div><div><dt>Dirección</dt><dd><%= emergencia.direccion || '—' %></dd></div></dl></article></section></main></body></html>
